        {
          "acao": "click",
          "alvo": {
            "role": "button",
            "name": "Salvar desastre"
          }
        }
      ],
      "resultado_esperado": {
        "descricao": "Ocorrência cadastrada visível na lista.",
        "verificacoes": [
          {
            "acao": "visible",
            "alvo": {
              "text": "Vendaval Regiao Sul {{RUN_ID}}"
            }
          }
        ]
      },
      "excecoes": [
        {
          "id": "EXC-01-01",
          "cenario": "Ocorrência sem título obrigatório impede gravação",
          "passos": [
            {
              "acao": "fill",
              "alvo": {
                "css": "#desastre-nome"
              },
              "valor": ""
            }
          ],
          "resultado_esperado": {
            "descricao": "Botão Salvar desastre visível mas formulário bloqueado.",
            "verificacoes": [
              {
                "acao": "visible",
                "alvo": {
                  "role": "button",
                  "name": "Salvar desastre"
                }
              }
            ]
          }
        }
      ]
    }
  ]
