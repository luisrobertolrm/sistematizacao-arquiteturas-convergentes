        {
          "acao": "click",
          "alvo": {
            "role": "button",
            "name": "Desastres e áreas"
          }
        },
        {
          "acao": "click",
          "alvo": {
            "role": "button",
            "name": "Ocorrências"
          }
        },
        {
          "acao": "fill",
          "alvo": {
            "css": "#desastre-nome"
          },
          "valor": "Vendaval Regiao Sul {{RUN_ID}}"
