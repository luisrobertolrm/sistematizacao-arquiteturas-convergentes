        {
          "acao": "click",
          "alvo": {
            "role": "button",
            "name": "Salvar área"
          }
        }
      ],
      "resultado_esperado": {
        "descricao": "Área afetada cadastrada visível na listagem.",
        "verificacoes": [
          {
            "acao": "visible",
            "alvo": {
              "text": "Comunidade Baixada {{RUN_ID}}"
            }
          }
        ]
      },
      "excecoes": [
        {
          "id": "EXC-01-01",
          "cenario": "Área sem nome preenchido não permite salvar",
          "passos": [
            {
              "acao": "fill",
              "alvo": {
                "css": "#area-nome"
              },
              "valor": ""
            }
          ],
          "resultado_esperado": {
            "descricao": "Botão Salvar área visível com formulário impedido de submissão.",
            "verificacoes": [
              {
                "acao": "visible",
                "alvo": {
                  "role": "button",
                  "name": "Salvar área"
                }
              }
            ]
          }
        }
      ]
    }
  ]
