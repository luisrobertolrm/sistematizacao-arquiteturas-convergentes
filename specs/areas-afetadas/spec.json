      "passos": [
        {
          "acao": "click",
          "alvo": {
            "role": "button",
            "name": "Desastres e áreas"
          }
        },
        {
          "acao": "click",
          "alvo": {
            "role": "button",
            "name": "Ocorrências"
          }
        },
        {
          "acao": "click",
          "alvo": {
            "role": "button",
            "name": "Áreas e mapa"
          }
        },
        {
          "acao": "fill",
          "alvo": {
            "css": "#area-nome"
          },
          "valor": "Comunidade Baixada {{RUN_ID}}"
        },
        {
          "acao": "select",
          "alvo": {
            "css": "#area-severidade"
          },
          "valor": "alta"
