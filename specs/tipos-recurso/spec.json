        {
          "acao": "click",
          "alvo": {
            "role": "button",
            "name": "Tipos de recurso"
          }
        },
        {
          "acao": "fill",
          "alvo": {
            "css": "#recurso-nome"
          },
          "valor": "Bote Resgate {{RUN_ID}}"
        },
        {
          "acao": "select",
          "alvo": {
            "css": "#recurso-categoria"
          },
          "valor": "equipamento"
