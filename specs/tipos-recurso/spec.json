        {
          "acao": "click",
          "alvo": {
            "role": "button",
            "name": "Salvar cadastro"
          }
        }
      ],
      "resultado_esperado": {
        "descricao": "Tipo de recurso cadastrado visível na lista.",
        "verificacoes": [
          {
            "acao": "visible",
            "alvo": {
              "text": "Bote Resgate {{RUN_ID}}"
            }
          }
        ]
      },
      "excecoes": [
        {
          "id": "EXC-01-01",
          "cenario": "Submissão sem preenchimento do nome obrigatório",
          "passos": [
            {
              "acao": "fill",
              "alvo": {
                "css": "#recurso-nome"
              },
              "valor": ""
            }
          ],
          "resultado_esperado": {
            "descricao": "Botão Salvar cadastro visível sem submissão de dados.",
            "verificacoes": [
              {
                "acao": "visible",
                "alvo": {
                  "role": "button",
                  "name": "Salvar cadastro"
                }
              }
            ]
          }
        }
      ]
