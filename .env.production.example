# =============================================================================
# redesolidaria — exemplo de .env de PRODUCAO (CasaOS + Docker + Cloudflare).
# Copie para `.env` no diretorio do app no servidor e preencha.
#   cp .env.production.example .env
# O .env NAO e versionado nem copiado para a imagem (fica so no servidor).
# =============================================================================

# Porta publicada no host (o Cloudflare Tunnel aponta para 192.168.2.170:APP_PORT).
APP_PORT=8007

# --- Banco (container 'postgres' compartilhado na rede 'shared-db') ------------
# Host = 'postgres' (nome do container na rede shared-db), NAO localhost. Driver psycopg.
REDE_DATABASE_URL=postgresql+psycopg://redesolidaria:SENHA_DO_BANCO@postgres:5432/redesolidaria

REDE_ENVIRONMENT=production

# --- Web / CORS ----------------------------------------------------------------
# O SPA e servido pela propria API (mesma origem), entao CORS so e necessario se
# algum cliente externo chamar a API direto. Inclua aqui a URL publica do tunnel.
REDE_CORS_ORIGINS=["http://192.168.2.170:8007"]

# --- Autenticação e Criptografia -----------------------------------------------
# Segredo JWT (minimo 32 caracteres hexadecimais aleatorios).
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
REDE_JWT_SECRET=
REDE_JWT_ISSUER=redesolidaria-api
REDE_JWT_AUDIENCE=redesolidaria-api

# Chave Fernet de criptografia simetrica (32 bytes url-safe base64).
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REDE_ENCRYPTION_KEY=
REDE_ENCRYPTION_KEY_ID=fernet-v1

# --- IA / LLM ------------------------------------------------------------------
# Lista exata de endpoints autorizados; vazia impede chamadas externas de IA.
# Exemplo: REDE_IA_URLS_PERMITIDAS=["https://ark.ap-southeast.bytepluses.com/api/v3"]
REDE_IA_URLS_PERMITIDAS=[]
