{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-tester:suite-mapping:3.0.0",
  "title": "Mapeamento Mestre da Suite de Testes",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao_contrato", "projeto", "funcionalidades"],
  "properties": {
    "versao_contrato": { "type": "string", "enum": ["3.0.0"] },
    "projeto": {
      "type": "object",
      "required": ["nome"],
      "properties": {
        "nome": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "gerado_por": { "type": "string" },
        "atualizado_em": { "type": "string" }
      }
    },
    "funcionalidades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nome", "arquivo_spec"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$" },
          "nome": { "type": "string", "minLength": 1 },
          "pasta": { "type": "string" },
          "arquivo_spec": { "type": "string", "minLength": 1 },
          "arquivo_historico": { "type": "string" },
          "objetivo": { "type": "string" },
          "total_fluxos": { "type": "integer", "minimum": 0 },
          "total_excecoes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
