REDE_DATABASE_URL=postgresql+psycopg://redesolidaria:SUBSTITUIR@localhost:55432/redesolidaria
REDE_ENVIRONMENT=development
REDE_CORS_ORIGINS=["http://localhost:4200"]
# Gerar um segredo aleatório; nunca usar o exemplo como segredo real.
REDE_JWT_SECRET=
REDE_JWT_ISSUER=redesolidaria-local
REDE_JWT_AUDIENCE=redesolidaria-api
# Chave Fernet gerada localmente; separada de credenciais criptografadas no banco.
REDE_ENCRYPTION_KEY=

REDE_ENCRYPTION_KEY_ID=fernet-v1
# Lista exata de endpoints autorizados; vazia impede chamadas de IA.
REDE_IA_URLS_PERMITIDAS=[]
# Exemplo: REDE_IA_URLS_PERMITIDAS=["https://provedor.example/v1"]
